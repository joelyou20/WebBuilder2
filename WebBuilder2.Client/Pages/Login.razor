@page "/identity/account/login"
@using Microsoft.AspNetCore.Components.Forms

<div class="login-overlay">
    <MudImage Src="../resources/pexels-mdx014-814499.jpg"></MudImage>
    <div class="login-container">
        <div class="login-content">
            <MudText>Welcome to WebBuilder2! Please login to continue!</MudText>
            <EditForm Model="@_request" OnValidSubmit="@HandleLogin">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <MudTextField id="email" @bind-Value="_request.Username" T="string" Placeholder="Email Address" Variant="Variant.Outlined" Required="true" For="@(() => _request.Username)" />
                <MudTextField id="password" @bind-Value="_request.Password" T="string" Placeholder="Password" Variant="Variant.Outlined" Required="true" For="@(() => _request.Password)" />
                <MudCheckBox Label="Remember Me" @bind-Checked="_request.RememberMe" T="bool" For="@(() => _request.RememberMe)"></MudCheckBox>
                <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Submit">Login</MudButton>
                <MudButton Variant="Variant.Filled" Href="/identity/account/register">Register</MudButton>
            </EditForm>
        </div>
    </div>
</div>