@page "/repository/{Id:long}"
@using Microsoft.AspNetCore.Components.Forms;

@if(_repo != null)
{
    <MudText>@_repo.Name</MudText>
    <MudFileUpload T="IBrowserFile" FilesChanged="OnUploadFileBtnClicked">
        <ActivatorContent>
            <MudButton HtmlTag="label"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.CloudUpload">
                Upload Files
            </MudButton>
        </ActivatorContent>
    </MudFileUpload>
    <div class="rd-content">
        <MudTreeView Items="@BuildTree(_repoTree)"
                     SelectedValueChanged="@(EventCallback.Factory.Create<GitTreeItem>(this, OnSelectedFileChanged))"
                     Hover="true"
                     ExpandOnClick="true">
            <ItemTemplate>
                @if(context.Value?.Type == GitTreeType.Tree)
                {
                    <MudTreeViewItem @bind-Expanded="@context.Value.IsExpanded"
                                    Items="@(new List<TreeItemData<GitTreeItem>>{context})"
                                    T="GitTreeItem"
                                    Value="@context.Value"
                                    Icon="@GetIcon(context.Value)"
                                    Text="@context.Value.Path.Split('/').Last()" />
                }
                else
                {
                    <MudTreeViewItem Value="@context" Icon="@GetIcon(context.Value!)" Text="@context.Value?.Path.Split('/').Last()" />
                }
            </ItemTemplate>
        </MudTreeView>
        <CodeEditor @ref="@_codeEditor" />
    </div>
}
else
{
    <MudText>Loading...</MudText>
}
